# Optional process settings; model connections can be configured in the UI.
# Live market quotes do not require a model key.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TIMEOUT=45
LLM_CONCURRENCY=3
LLM_MAX_CALLS=300

# Optional remote hosting. Keep the default local-only settings for local use.
# Set the actual backend hostname (no scheme or path).
# ALPHALAB_ALLOWED_HOSTS=127.0.0.1,localhost,api.your-domain.example
# ALPHALAB_CORS_ORIGINS=https://usbfl.github.io
# Generate a random token on your server; never commit it.
ALPHALAB_ACCESS_TOKEN=
# Persistent database location in the Docker container:
# ARENA_DB=/app/data/arena.sqlite3

# Required on Linux/Docker when saving model credentials. Keep it stable and secret.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALPHALAB_SECRET_KEY=
